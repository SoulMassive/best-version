{
  "version": 2,
  "builds": [
    {
      "src": "serverless/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["backend/src/**"] }
    },
    {
      "src": "serverless/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "serverless/health.js" },
    { "source": "/api/(.*)", "destination": "serverless/index.js" },
    { "source": "/(.*)", "destination": "/frontend/dist/index.html" }
  ]
}
