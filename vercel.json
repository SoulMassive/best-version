{
  "version": 2,
  "buildCommand": "npm --prefix frontend run build",
  "installCommand": "npm install && npm --prefix frontend install && npm --prefix backend install",
  "trailingSlash": false,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "runtime": "vercel-node@latest",
      "includeFiles": "backend/src/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/assets/(.*)", "destination": "frontend/dist/assets/$1" },
    { "source": "/((?!api/).*)", "destination": "frontend/dist/index.html" }
  ]
}
