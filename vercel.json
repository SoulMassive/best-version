{
  "version": 2,
  "buildCommand": "npm --prefix frontend run build",
  "installCommand": "npm install && npm --prefix frontend install && npm --prefix backend install",
  "functions": {
    "api/index.js": {
      "runtime": "vercel-node@latest",
      "includeFiles": "backend/src/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/frontend/dist/$1", "check": true },
    { "source": "/(.*)", "destination": "/frontend/dist/index.html" }
  ]
}
